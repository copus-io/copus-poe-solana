# Solana Devnet only. Put real values in an untracked .env or your secret manager.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=/path/outside/repository/devnet-payer.json
POE_PROGRAM_ID=<deployed program public key>
POE_TREASURY_ADDRESS=<different Devnet public key>

# Private services and local settlement stub. Never publish live credentials.
PROVER_TOKEN=<at least 32 random characters>
PROVER_PORT=8790
SETTLEMENT_TOKEN=<different 32-character random secret>
SETTLEMENT_URL=http://127.0.0.1:8791/settlements
SETTLEMENT_PORT=8791
INDEXER_DB=./poe-solana-indexer.db
LEDGER_DB=./poe-solana-demo-ledger.db
